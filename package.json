{
  "name": "oryphemrouter-app",
  "version": "1.0.0",
  "description": "OryphemRouter web dashboard",
  "private": true,
  "scripts": {
    "dev": "next dev --port 20129",
    "dev:webpack": "next dev --webpack --port 20129",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node custom-server.js --port 20129",
    "dev:bun": "bun --bun next dev --webpack --port 20129",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@aws-sdk/client-bedrock-runtime": "^3.1119.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@next/third-parties": "^16.2.9",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "^12.10.1",
    "antd": "^6.6.2",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "confbox": "^0.2.4",
    "dompurify": "^3.4.9",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.44.6",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.3",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "parse5": "^8.0.1",
    "playwright": "^1.62.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^19.2.8",
    "recharts": "^3.7.0",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "tls-client-node": "^0.2.0",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4"
  },
  "overrides": {
    "dompurify": "^3.4.9"
  }
}
