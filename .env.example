# OryphemRouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
# JWT_SECRET — DO NOT use a placeholder. Generate with: openssl rand -hex 32
# If left unset, a random secret is generated on first boot and stored in DATA_DIR/jwt-secret
# JWT_SECRET=<generated-by-openssl-rand-hex-32>

# INITIAL_PASSWORD — Optional. If unset, the default password is "123"
# and remote login requires changing it first. Set only if you need remote
# password-based login on first boot (not recommended).
# INITIAL_PASSWORD=your-secure-initial-password
DATA_DIR=/var/lib/oryphemrouter

# Recommended runtime variables
PORT=20129
NODE_ENV=production

# Recommended security and ops variables
# API_KEY_SECRET — if unset, falls back to a hardcoded value (NOT recommended for production).
# Generate with: openssl rand -hex 32
# API_KEY_SECRET=<generated-by-openssl-rand-hex-32>
# MACHINE_ID_SALT — if unset, falls back to a hardcoded value (NOT recommended for production).
# MACHINE_ID_SALT=<generated-by-openssl-rand-hex-32>
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20129
CLOUD_URL=https://oryphem.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20129
NEXT_PUBLIC_CLOUD_URL=https://oryphem.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Optional Google OAuth client credentials (for Gemini / Gemini CLI / Antigravity OAuth login)
# If unset, OAuth login for these providers will not work. Obtain from Google Cloud Console
# (OAuth 2.0 Client IDs → Desktop/CLI app) and register the redirect URI below:
#   http://localhost:20129/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=oryphemrouter